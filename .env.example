# Claude
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... (safe for the browser; replaces the old "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... (server only, NEVER prefix with NEXT_PUBLIC_; replaces the old "service_role" key)
SUPABASE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clippilot
R2_PUBLIC_URL=

# YouTube / Google OAuth
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# Login (single user). Dev: leave empty to skip login. Production: required.
APP_PASSWORD=
# Random 64-char hex, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Secrets
CRON_SECRET=
WORKER_SECRET=
TOKEN_ENCRYPTION_KEY=
