# ---------- Claude (scripts) ----------
# console.anthropic.com → API Keys (sk-ant-api…). The account needs prepaid credits.
ANTHROPIC_API_KEY=

# ---------- Supabase (database + preview storage) ----------
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... (safe for the browser; replaces the old "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... (server only, NEVER prefix with NEXT_PUBLIC_; replaces the old "service_role" key)
SUPABASE_SECRET_KEY=

# ---------- YouTube ----------
# Trend search (Google Cloud → Credentials → API key, restricted to YouTube Data API v3)
YOUTUBE_API_KEY=
# Uploading (Google Cloud → Credentials → OAuth client ID → Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that OAuth client exactly
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# ---------- Login (single user) ----------
# Dev: leave empty to skip login. Production: required.
APP_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=

# ---------- Secrets (each: openssl rand -hex 32) ----------
# Vercel Cron → /api/cron/*
CRON_SECRET=
# Render worker on your Mac → /api/worker/*
WORKER_SECRET=
# Encrypts the YouTube refresh token in the database (64 hex chars). Don't change it after connecting.
TOKEN_ENCRYPTION_KEY=

# ---------- Render worker (optional) ----------
# Where the worker finds the app (default http://localhost:3000; your Vercel URL in production)
CLIPPILOT_URL=
# macOS voice for narration — list with: say -v '?'
WORKER_VOICE=Samantha
WORKER_VOICE_RATE=185
WORKER_BRAND=ClipPilot

# ---------- Public legal pages (privacy / terms / contact) ----------
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional company/person name on the legal pages (default: "the ClipPilot team")
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SITE_URL=https://clipplot.vercel.app

# ---------- Cloud worker (GitHub Actions) — optional instant start ----------
# Fine-grained GitHub token (this repo only, Actions: Read and write). Vercel calls GitHub to start the
# worker as soon as a video is queued; without it the workflow still runs every 15 minutes.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=salmanamjad6863/clipplot
