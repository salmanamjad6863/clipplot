{
  "name": "clippilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:dedupe": "node --no-warnings scripts/dedupe-check.ts",
    "db:check": "node --env-file=.env.local scripts/db-check.mjs",
    "db:seed": "node --no-warnings --env-file=.env.local scripts/db-seed.ts",
    "test:discovery": "tsx scripts/discovery-check.mts",
    "test": "pnpm test:dedupe && pnpm test:discovery && pnpm test:upload",
    "worker": "node --no-warnings --env-file=.env.local --import tsx worker/index.mts",
    "test:upload": "tsx scripts/upload-check.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}